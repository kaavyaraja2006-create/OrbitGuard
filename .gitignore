# =====================================================================
#  ORBITGUARD .gitignore
#  Push source code, configuration and documentation only.
#  Never push: data, databases, secrets, builds, caches, logs, outputs.
# =====================================================================

# ---------------------------------------------------------------------
# Secrets and credentials (Space-Track, SMTP, session keys…)
# ---------------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json

# ---------------------------------------------------------------------
# Data: datasets, catalogues, uploads (ESA Kelvins, SOCRATES, TLEs)
# ---------------------------------------------------------------------
data/raw/*
data/processed/*
data/reference/*
data/experiments/*
!data/**/.gitkeep
*.tle
*.3le
*.zip
*.tar
*.tar.gz
*.7z
*.csv
*.parquet
*.h5
*.hdf5
*.npy
*.npz
*.pkl

# ---------------------------------------------------------------------
# Databases
# ---------------------------------------------------------------------
*.db
*.db-journal
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---------------------------------------------------------------------
# Generated research outputs (reproduce with examples/run_experiments.py)
# ---------------------------------------------------------------------
research/experiments/results/*.json
research/experiments/results/*.csv
synthetic.tle

# ---------------------------------------------------------------------
# Python
# ---------------------------------------------------------------------
__pycache__/
*.py[cod]
*.so
*.egg-info/
*.egg
.eggs/
build/
dist/
.venv/
venv/
env/
.python-version
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.ipynb_checkpoints/

# ---------------------------------------------------------------------
# Node / frontend
# ---------------------------------------------------------------------
node_modules/
frontend/dist/
frontend/public/cesium/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ---------------------------------------------------------------------
# Logs, temp files, screenshots from local testing
# ---------------------------------------------------------------------
*.log
logs/
tmp/
temp/
*.tmp
*.bak
*.swp
*~

# ---------------------------------------------------------------------
# Editors and OS
# ---------------------------------------------------------------------
.vscode/
!.vscode/extensions.json
.idea/
*.code-workspace
.DS_Store
Thumbs.db
desktop.ini
